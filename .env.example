# External Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...
LANGSMITH_API_KEY=ls__...
GOOGLE_API_KEY=""

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_chunks

# Redis (Celery Broker & Cache)
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1

# PostgreSQL
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents

# Application Settings
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
LOG_LEVEL=INFO
ENVIRONMENT=development

# Object Storage (MinIO) Extra
MINIO_USE_SSL=false

# Retrieval Configuration
RETRIEVAL_TOP_K=10
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_FINAL_TOP_K=5
